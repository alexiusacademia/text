// text: spelling. A `Speller` made from a word list says whether a word
// is spelled right (`isCorrect`), finds the misspelled words of a text
// (`misspellings`), and suggests what was meant (`suggest`); it keeps the
// user's own words and the ones they chose to ignore. `autocorrect` puts
// right the commonest typing slips as they are typed. Moved here from
// Quill (words/spell.tsl), which it was written for.
//
// The word list is the caller's: `systemWordList()` reads the system's
// (/usr/share/dict/words, one word a line, on macOS and Linux), and the
// user's own dictionary file has the same form. That list has few
// inflected forms, so a word is also right when taking a regular English
// ending off it (plural, -ed, -ing, -er, -est, -ly, -ness) gives a listed
// word, with the usual spelling rules (a doubled consonant, a dropped e,
// y turned to i). A consonant must be doubled where English doubles it
// and may not be where it doesn't ("stopping" and "opening"; not
// "stoping", "openning"), as far as short lists of words can tell: see
// `spellMayDouble` and the lists before it. A few wrong words still get
// through where a rarer word explains them ("planing" is "plane" +
// "ing"); it is the price of not flagging half of ordinary prose.
//
// A `Speller` is a value like everything else; handing it to a function
// copies nothing, so keep one in the app's state and pass it along.
//
// First written for Quill on 2026-10-06.
//
// Author: Alexius Academia
// Date: 2026-10-30

// The words that are right. `words` holds the list as it was given
// (proper nouns with their capital), the words added here and the
// user's; `user` only the user's, in the order they were added;
// `ignored` the words of "Ignore All"; `once` the single places of
// "Ignore Once" (see `ignoreOnce`). Make one with `speller`.
public struct Speller {
    words: Set<String> = []
    user: [String] = []
    ignored: Set<String> = []
    once: Set<String> = []
    // The commonest words, which a suggestion is likelier to be, and
    // the contractions.
    common: Set<String> = []
    contractions: Set<String> = []
    // Everyday words (the commonest among them), which a suggestion is
    // likelier to be than a rare word.
    frequent: Set<String> = []
    // Spellings that the rules for endings would let through and that
    // are wrong all the same ("occured", "truely").
    banned: Set<String> = []
    // What the rules for endings know about single words (see the
    // lists they are made from): words of several syllables that
    // double their last letter before an ending, ones that may, short
    // words whose twin with an e takes no endings, and words in -f
    // whose plural is -ves.
    doubling: Set<String> = []
    eitherDouble: Set<String> = []
    twins: Set<String> = []
    ves: Set<String> = []

    // Whether a word is spelled right.
    //   - Not checked at all, so right: a single letter, a word with a
    //     digit in it, a word all in capitals (an acronym, a heading), a
    //     web or e-mail address (anything with "@", "://", "www." or a
    //     point between letters), and a word the user ignored.
    //   - Capitals: "The" and "THE" are right for "the"; "london" is
    //     wrong for "London"; a mix such as "tHe" only as listed.
    //   - A hyphenated word is right when each part is.
    //   - Apostrophes (curly or plain): the usual contractions are right,
    //     and so is a right word with 's, s', 'll, 're, 've or 'd.
    fn isCorrect(_ word: String) -> Bool {
        spellCheck(self, spellTidy(word))
    }

    // Up to `limit` words to offer for a misspelled one, the likeliest
    // first; nothing for a word that is right. See `spellSuggest`.
    fn suggest(_ word: String, limit: Int = 5) -> [String] {
        spellSuggest(self, word, limit: limit)
    }

    // The misspelled words of `text`, in order, with the code point
    // indexes each runs from and up to. See `misspellingsIn`.
    fn misspellings(_ text: String) -> [Misspelling] {
        misspellingsIn(self, text)
    }

    // Adds the words of the user's dictionary file (one a line).
    fn loadUserWords(_ text: String) {
        for line in text.replace("\r", with: "\n").split("\n") {
            let w = line.trim()
            if w.isEmpty || words.contains(w) { continue }
            words.insert(w)
            user.append(w)
        }
    }

    // "Add to Dictionary": the word is right from now on. Gives the text
    // to append to the user's dictionary file (the word and a line
    // break), or "" when the word was there already.
    fn addWord(_ word: String) -> String {
        let w = spellTidy(word)
        if w.isEmpty || words.contains(w) { return "" }
        words.insert(w)
        user.append(w)
        w + "\n"
    }

    // The user's dictionary as the text of its file.
    fn userWordsText() -> String {
        var s = ""
        for w in user {
            s += w + "\n"
        }
        s
    }

    // "Ignore All": the word, written this way or in small letters, isn't
    // flagged again while this speller lives.
    fn ignoreAll(_ word: String) {
        let w = spellTidy(word)
        if !w.isEmpty { ignored.insert(w) }
    }

    // "Ignore Once": this one misspelling (one of `misspellings(text)`)
    // isn't flagged again; the same word elsewhere still is. What is kept
    // is the word and the few characters around it, so it stays ignored
    // while other parts of the text are edited, and is flagged again when
    // the text right next to it changes.
    fn ignoreOnce(_ text: String, _ m: Misspelling) {
        once.insert(spellOnceKey(text.characters, m.from, m.to))
    }

    // Forgets every "Ignore Once" and "Ignore All" (Word's "Recheck
    // Document"). The user's words stay.
    fn resetIgnored() {
        ignored = []
        once = []
    }
}

// A word that isn't spelled right in a text: the code point indexes it
// runs from and up to, and the word (with a plain apostrophe).
public struct Misspelling {
    from: Int = 0
    to: Int = 0
    word: String = ""
}

// Words every text uses that the system's list leaves out: forms of the
// commonest verbs, words newer than the list, and names of places.
