// text: how hard a text is to read. `textStats` counts its sentences,
// words, syllables and letters; the methods of `TextStats` give the usual
// readability formulas from those counts: Flesch Reading Ease,
// Flesch-Kincaid grade, Gunning fog, SMOG, Coleman-Liau and the Automated
// Readability Index, plus reading time.
//
// Syllables are counted by rules for English spelling (vowel groups, a
// silent e, -es and -ed endings, vowel pairs that are two syllables). The
// rules give the same count as the CMU Pronouncing Dictionary for 93.6% of
// the 35,627 words it shares with /usr/share/dict/words, and 97.5% of the
// words of ordinary prose: close enough for formulas that average over a
// whole text, and the formulas were made with counts like these.
//
// Author: Alexius Academia
// Date: 2026-10-30

// The counts of a text.
public struct TextStats {
    sentences: Int = 0
    words: Int = 0
    syllables: Int = 0
    // Letters and digits in the words.
    letters: Int = 0
    // Words of three syllables or more.
    polysyllables: Int = 0

    fn wordsPerSentence() -> Float {
        if sentences == 0 { 0.0 } else { Float(words) / Float(sentences) }
    }

    fn syllablesPerWord() -> Float {
        if words == 0 { 0.0 } else { Float(syllables) / Float(words) }
    }

    // Flesch Reading Ease: 206.835 − 1.015 × words per sentence − 84.6 ×
    // syllables per word. 90 to 100 is easy for an 11-year-old, 60 to 70
    // plain English, below 30 for university graduates. 0 for no words.
    fn fleschReadingEase() -> Float {
        if words == 0 || sentences == 0 {
            return 0.0
        }
        206.835 - 1.015 * wordsPerSentence() - 84.6 * syllablesPerWord()
    }

    // Flesch-Kincaid grade level: 0.39 × words per sentence + 11.8 ×
    // syllables per word − 15.59, the US school grade that can read it.
    fn fleschKincaidGrade() -> Float {
        if words == 0 || sentences == 0 {
            return 0.0
        }
        0.39 * wordsPerSentence() + 11.8 * syllablesPerWord() - 15.59
    }

    // Gunning fog index: 0.4 × (words per sentence + 100 × share of words
    // with three syllables or more), in years of schooling.
    fn gunningFog() -> Float {
        if words == 0 || sentences == 0 {
            return 0.0
        }
        0.4 * (wordsPerSentence() + 100.0 * Float(polysyllables) / Float(words))
    }

    // SMOG grade: 1.0430 × √(words of three syllables or more × 30 /
    // sentences) + 3.1291. Meant for 30 sentences or more.
    fn smogIndex() -> Float {
        if sentences == 0 {
            return 0.0
        }
        1.043 * sqrt(Float(polysyllables) * 30.0 / Float(sentences)) + 3.1291
    }

    // Coleman-Liau index: 0.0588 × letters per 100 words − 0.296 ×
    // sentences per 100 words − 15.8, a grade level from letters rather
    // than syllables.
    fn colemanLiauIndex() -> Float {
        if words == 0 {
            return 0.0
        }
        let l = Float(letters) / Float(words) * 100.0
        let s = Float(sentences) / Float(words) * 100.0
        0.0588 * l - 0.296 * s - 15.8
    }

    // Automated Readability Index: 4.71 × letters per word + 0.5 × words
    // per sentence − 21.43.
    fn automatedReadabilityIndex() -> Float {
        if words == 0 || sentences == 0 {
            return 0.0
        }
        4.71 * Float(letters) / Float(words) + 0.5 * wordsPerSentence() - 21.43
    }

    // The minutes it takes to read, at `wordsPerMinute` (238 is the average
    // adult reading English non-fiction silently).
    fn readingMinutes(wordsPerMinute: Float = 238.0) -> Float {
        Float(words) / wordsPerMinute
    }
}

// The counts of `text`: its sentences (those with a word in them), words
// (see `words`), syllables, letters and words of three syllables or more.
public fn textStats(_ text: String) -> TextStats {
    var st = TextStats()
    for s in sentences(text) {
        let ws = words(s)
        if ws.isEmpty {
            continue
        }
        st.sentences += 1
        for w in ws {
            st.words += 1
            let n = syllables(w)
            st.syllables += n
            if n >= 3 {
                st.polysyllables += 1
            }
            for c in codePoints(w) {
                if isAlphanumeric(c) {
                    st.letters += 1
                }
            }
        }
    }
    st
}

// The vowel of an accented Latin letter ("é" is "e"), or the letter.
fn plainLetter(_ ch: String) -> String {
    if "àáâãäåā".contains(ch) { return "a" }
    if "èéêëēė".contains(ch) { return "e" }
    if "ìíîïī".contains(ch) { return "i" }
    if "òóôõöøō".contains(ch) { return "o" }
    if "ùúûüū".contains(ch) { return "u" }
    if "ýÿ".contains(ch) { return "y" }
    ch
}

fn sylVowel(_ ch: String) -> Bool {
    ch == "a" || ch == "e" || ch == "i" || ch == "o" || ch == "u" || ch == "y"
}

// How many syllables an English word has, by spelling rules: syllables
// ("readability") is 5, syllables("cake") 1, syllables("café") 2. A
// number or a word without vowels counts as 1; "" as 0. Rules miss some
// words: "created" gets 2 (the "ea" read as one vowel), "recipe" 2.
public fn syllables(_ word: String) -> Int {
    var cs: [String] = []
    // Whether the last letter is an accented e, which is said (café).
    var saidE = false
    for ch in caseFold(word).characters {
        let p = plainLetter(ch)
        if p >= "a" && p <= "z" && p.count == 1 {
            cs.append(p)
            saidE = p == "e" && ch != "e"
        }
    }
    if cs.isEmpty {
        return if word.isEmpty { 0 } else { 1 }
    }
    let w = cs.joined()
    // Groups of vowels.
    var n = 0
    var inVowel = false
    for ch in cs {
        let v = sylVowel(ch)
        if v && !inVowel {
            n += 1
        }
        inVowel = v
    }
    // Vowel pairs said as two syllables, and the ones said as one after all.
    for p in ["ia", "io", "eo", "ua", "uo", "iu", "ii", "iet", "yi", "ya", "yo", "ao", "eous", "uen", "uet", "uel", "iel", "oet", "eity"] {
        n += w.occurrences(of: p)
    }
    for p in ["cia", "tia", "sio", "tio", "gio", "cio", "xio", "gia", "giu", "qua", "quo", "gua", "guo", "eous", "ciu", "tiu"] {
        n -= w.occurrences(of: p)
    }
    for k in 0..cs.count {
        // A vowel then "ing" (going, being), and a vowel then "yer" (player).
        if k + 3 < cs.count && "aeiou".contains(cs[k]) && cs[k + 1] == "i" && cs[k + 2] == "n" && cs[k + 3] == "g" {
            n += 1
        }
        if k + 3 < cs.count && "aeiou".contains(cs[k]) && cs[k + 1] == "y" && cs[k + 2] == "e" && cs[k + 3] == "r" {
            n += 1
        }
    }
    if w.hasSuffix("ier") || w.hasSuffix("ism") || w.hasSuffix("eal") {
        n += 1
    }
    if w.hasSuffix("sia") || w.hasSuffix("ically") {
        n -= 1
    }
    let m = cs.count
    // The e before an ending is silent: hopeful, statement, lovely.
    for end in ["ful", "less", "ness", "ment", "ly", "ry"] {
        let k = m - end.count
        if k >= 2 && w.hasSuffix(end) && cs[k - 1] == "e" && !sylVowel(cs[k - 2]) {
            n -= 1
        }
    }
    // A final e is silent, but not in -ee, -ye, -oe, -ie or a consonant + le.
    if w.hasSuffix("e") && n > 1 && !saidE {
        let keep = w.hasSuffix("ee") || w.hasSuffix("ye") || w.hasSuffix("oe") || w.hasSuffix("ie") ||
            (m >= 3 && w.hasSuffix("le") && !sylVowel(cs[m - 3]))
        if !keep {
            n -= 1
        }
    }
    // -es and -ed are silent except after the sounds that need them.
    if w.hasSuffix("es") && n > 1 && m >= 3 {
        let before = cs[m - 3]
        let two = if m >= 4 { cs[m - 4] + before } else { before }
        let said = before == "s" || before == "x" || before == "z" || before == "i" || two == "ch" || two == "sh" ||
            two == "ge" || two == "ce" || two == "ee" || (before == "l" && m >= 4 && !sylVowel(cs[m - 4]))
        if !said {
            n -= 1
        }
    }
    if w.hasSuffix("ed") && n > 1 && m >= 3 {
        let before = cs[m - 3]
        let said = before == "t" || before == "d" || before == "e" || before == "i" || (before == "l" && m >= 4 && !sylVowel(cs[m - 4]))
        if !said {
            n -= 1
        }
    }
    if n < 1 { 1 } else { n }
}
