     "tiping", "toping", "fliping", "wining", "squating", "quiping", "formating", "formated", "occuring", "refering", "exceling", "expeled", "patroling", "incuring",
     "recuring", "transmiting", "acquited", "regreted", "overlaping", "unpluged", "openning", "visitted", "happenning", "listenning", "helpping", "feelling",
     "offerring", "enterred", "gatherring", "developped", "budgetted", "shelfs", "halfs", "wifes", "lifes", "thiefs", "selfs", "elfs", "calfs", "bookshelfs", "housewifes"]
}

