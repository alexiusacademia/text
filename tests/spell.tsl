fn spellMs(_ seconds: Float) -> String {
    (seconds * 1000.0).formatted(decimals: 1) + " ms"
}

fn spellSystem() -> Int {
    let list = text.systemWordList()
    if list.count < 100000 {
        print("no /usr/share/dict/words here: the checks with the system's list are skipped")
        return 0
    }
    var failed = 0
    var t0 = now()
    let sp = text.speller(list)
    let build = now() - t0
    failed += holds("a speller from {list.lines().count} words in {spellMs(build)}", build < 1.0)

    var flagged: [String] = []
    var wordCount = 0
    for line in prose() {
        wordCount += line.words().count
        for m in sp.misspellings(line) {
            flagged.append(m.word)
        }
    }
    failed += same("ordinary prose ({wordCount} words) isn't flagged", "{flagged}", "[]")

    let pairs = slips()
    var missed: [String] = []
    var top1 = 0
    var top5 = 0
    var slowest = 0.0
    var total = 0.0
    for i in 0..(pairs.count / 2) {
        let wrong = pairs[i * 2]
        let meant = pairs[i * 2 + 1]
        if sp.isCorrect(wrong) { missed.append(wrong) }
        if !sp.isCorrect(meant) { missed.append(meant + "?") }
        t0 = now()
        let offers = sp.suggest(wrong, limit: 5)
        let took = now() - t0
        total += took
        slowest = max(slowest, took)
        if (offers.first ?? "") == meant { top1 += 1 }
        if offers.contains(meant) { top5 += 1 }
    }
    let n = pairs.count / 2
    failed += same("every misspelling is flagged", "{missed}", "[]")
    failed += holds("the word meant is offered for {top5} of {n} misspellings", top5 >= n - 3)
    failed += holds("and comes first for {top1}", top1 >= n * 3 / 4)
    failed += holds("suggesting takes {spellMs(total / Float(n))} on average, {spellMs(slowest)} at most", slowest < 0.1)

    let firsts = firstOffers()
    var firstRight = 0
    var firstWrong: [String] = []
    for i in 0..(firsts.count / 2) {
        let wrong = firsts[i * 2]
        let meant = firsts[i * 2 + 1]
        if sp.isCorrect(wrong) {
            firstWrong.append("{wrong} (not flagged)")
            continue
        }
        let offers = sp.suggest(wrong, limit: 5)
        if (offers.first ?? "") == meant {
            firstRight += 1
        } else {
            firstWrong.append("{wrong}: {offers.prefix(3).joined(separator: ", ")}")
        }
    }
    failed += holds("the first suggestion is right for {firstRight} of {firsts.count / 2}; not for {firstWrong}", firstRight >= firsts.count / 2 - 6)
    failed += same("lettr", sp.suggest("lettr").first ?? "", "letter")
    failed += same("ovr is over before or", sp.suggest("ovr").prefix(2).joined(separator: " "), "over or")
    failed += same("persue is pursue before peruse", sp.suggest("persue").prefix(2).joined(separator: " "), "pursue peruse")

    var passed: [String] = []
    for w in endingSlips() {
        if sp.isCorrect(w) { passed.append(w) }
    }
    failed += same("wrong endings are flagged", "{passed}", "[]")
    var refused: [String] = []
    for w in endingsRight() {
        if !sp.isCorrect(w) { refused.append(w) }
    }
    failed += same("right endings aren't", "{refused}", "[]")

    var many: [String] = []
    var plain: [String] = []
    for line in prose() {
        plain += line.replace(",", with: "").replace(".", with: "").replace(";", with: "").replace(":", with: "").replace("\"", with: "").words()
    }
    while many.count < 200000 {
        many += plain
    }
    t0 = now()
    var right = 0
    for w in many {
        if sp.isCorrect(w) { right += 1 }
    }
    var took = now() - t0
    failed += holds("{many.count} words checked one by one at {Int(Float(many.count) / took)} a second", Float(many.count) / took >= 100000.0 && right == many.count)
    t0 = now()
    var found = 0
    for _ in 0..40 {
        for line in prose() {
            found += sp.misspellings(line).count
        }
    }
    took = now() - t0
    failed += holds("texts checked at {Int(Float(wordCount * 40) / took)} words a second", Float(wordCount * 40) / took >= 100000.0 && found == 0)

    for w in ["has", "does", "boxes", "cities", "houses", "walked", "London", "England", "email", "online", "website", "okay", "it's", "don't", "children's", "twenty-one", "co-operate", "Mr", "I'm"] {
        if !sp.isCorrect(w) { failed += holds("'{w}' is right with the system's list", false) }
    }
    for w in ["dont", "thats", "untill", "sence", "occured", "begining", "truely", "london", "england", "recieved", "wierdly", "freinds"] {
        if sp.isCorrect(w) { failed += holds("'{w}' is wrong with the system's list", false) }
    }
    failed += same("received", sp.suggest("recieved").first ?? "", "received")
    failed
}

fn spellTests() -> Int {
    let sp = text.speller(smallList())
    var failed = spellWords(sp)
    failed += spellTexts(sp)
    failed += spellIgnoring()
    failed += spellSuggestions(sp)
    failed += spellAutocorrect(sp)
    failed += spellSystem()
    failed
}
